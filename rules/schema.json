{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trading-agent rules",
  "type": "object",
  "required": ["version", "floor_cash", "ceiling", "symbol_scope", "lanes"],
  "properties": {
    "version": {"type": "string"},
    "floor_cash": {"type": "number", "minimum": 0},
    "max_daily_loss": {"type": "number", "minimum": 0},
    "max_position_size": {"type": "number", "minimum": 0},
    "symbol_scope": {"type": "string", "enum": ["approved", "observable-market"]},
    "approved_symbols": {"type": "array", "items": {"type": "string"}},
    "featured_symbols": {"type": "array", "items": {"type": "string"}},
    "lanes": {
      "type": "object",
      "required": ["stock-market", "crypto"],
      "properties": {
        "stock-market": {
          "type": "object",
          "required": ["enabled", "paper_only", "symbol_scope", "featured_symbols"],
          "properties": {
            "enabled": {"const": true},
            "paper_only": {"const": true},
            "symbol_scope": {"const": "us-listed-directory"},
            "featured_symbols": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "crypto": {
          "type": "object",
          "required": ["enabled", "paper_only", "symbol_scope", "featured_symbols"],
          "properties": {
            "enabled": {"const": true},
            "paper_only": {"const": true},
            "symbol_scope": {"const": "classified-observation"},
            "featured_symbols": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capital_ladder": {
      "type": "object",
      "required": [
        "paper_only",
        "min_net_margin_pct",
        "max_days_held",
        "promotion_wins_required",
        "protected_profit_pct",
        "max_step_multiplier",
        "max_cycle_loss_pct",
        "can_auto_promote"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "paper_only": {"const": true},
        "min_net_margin_pct": {"type": "number", "minimum": 0},
        "max_days_held": {"type": "integer", "minimum": 1},
        "promotion_wins_required": {"type": "integer", "minimum": 1},
        "protected_profit_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "max_step_multiplier": {"type": "number", "minimum": 1},
        "max_cycle_loss_pct": {"type": "number", "exclusiveMinimum": 0},
        "can_auto_promote": {"const": false}
      },
      "additionalProperties": false
    },
    "modes": {
      "type": "object",
      "properties": {
        "truthmode": {"type": "boolean"},
        "redteam": {"type": "boolean"},
        "lindy": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "ceiling": {
      "type": "object",
      "required": ["current", "can_auto_increase"],
      "properties": {
        "current": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0},
        "can_auto_increase": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
